<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="FluentMigrator" Version="8.0.1" />
    <PackageReference Include="FluentMigrator.Runner.SqlServer" Version="8.0.1" />
  </ItemGroup>

  <!-- La línea base (001) carga los scripts originales de Database/ incrustados en el
       ensamblado: no hay copias a mano y siempre usan la versión vigente del repo. -->
  <ItemGroup>
    <EmbeddedResource Include="..\Database\01_Tablas.sql" LogicalName="Database.01_Tablas.sql" />
    <EmbeddedResource Include="..\Database\02_StoredProcedures.sql" LogicalName="Database.02_StoredProcedures.sql" />
    <EmbeddedResource Include="..\Database\03_Indices.sql" LogicalName="Database.03_Indices.sql" />
    <!-- 008 (HU-17) ejecuta el 09 y, en su Down(), restaura SP de 02 y 08. -->
    <EmbeddedResource Include="..\Database\08_SolicitudesHU15.sql" LogicalName="Database.08_SolicitudesHU15.sql" />
    <EmbeddedResource Include="..\Database\09_EstadoSolicitudesHU17.sql" LogicalName="Database.09_EstadoSolicitudesHU17.sql" />
  </ItemGroup>

  <!-- Permite que GlamSpaces.Tests pruebe las clases internal de este proyecto. -->
  <ItemGroup>
    <InternalsVisibleTo Include="GlamSpaces.Tests" />
  </ItemGroup>

</Project>
